// ============================================================
// DATABASE: clinical_schema
// PATH: prisma/clinical/schema.prisma
// ============================================================
// This schema manages all clinical/medical data:
// - Vitals (patient health metrics)
// - Scans (uploaded documents/images with versioning)
// - PrintJobs (PDF generation history)
// - AuditLogs (system activity tracking)
// - PatientProfile (patient preferences)
// - Doctor (clinical profile)
// - Medicine (reference catalog)
// - Consultation (doctor-patient sessions)
// - ConsentLog (patient consent history)
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../../generated/clinical-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CLINICAL_DATABASE_URL")
  schemas  = ["clinical_schema"]
}

// ============================================================
// ENUMS
// ============================================================

enum GenderEnum {
  MALE
  FEMALE
  OTHER
  @@map("gender_enum")
  @@schema("clinical_schema")
}

// ============================================================
// VITALS MODEL (Patient Health Metrics)
// ============================================================
// linkToken: references identity_schema.link_tokens.link_token
// No PII stored here — only clinical data
// ============================================================
model Vitals {
  recordId    String     @id @default(uuid()) @map("record_id") @db.Uuid
  linkToken   String?    @map("link_token")
  age         Int
  gender      GenderEnum
  height      Float?
  weight      Float?
  bp          String?
  temperature Float?
  bloodGroup  String?    @map("blood_group")

  @@map("vitals")
  @@schema("clinical_schema")
}

// ============================================================
// SCAN MODEL (Uploaded Documents/Images)
// ============================================================
// - Supports versioning (re-upload creates new version)
// - isLatest flag for quick latest version retrieval
// - parentScanId for version chain
// ============================================================
model Scan {
  scanId        String    @id @default(uuid()) @map("scan_id") @db.Uuid
  linkToken     String    @map("link_token")
  scanType      String    @map("scan_type")
  fileName      String    @map("file_name")
  filePath      String    @map("file_path")
  thumbnailPath String?   @map("thumbnail_path")
  fileSize      Int?      @map("file_size")
  mimeType      String?   @map("mime_type")
  ocrText       String?   @map("ocr_text")
  ocrConfidence Float?    @map("ocr_confidence")
  status        String    @default("UPLOADED")
  metadata      Json?
  uploadedAt    DateTime? @default(now()) @map("uploaded_at")
  processedAt   DateTime? @map("processed_at")

  // 🆕 BE-4: Report History/Versioning fields
  version       Int       @default(1) @map("version")
  parentScanId  String?   @map("parent_scan_id") @db.Uuid
  isLatest      Boolean   @default(true) @map("is_latest")

  // 🆕 BE-4: Print fields
  printedPdfPath String?   @map("printed_pdf_path")
  printedAt      DateTime? @map("printed_at")

  // Relations
  parentScan    Scan?     @relation("ScanVersions", fields: [parentScanId], references: [scanId])
  versions      Scan[]    @relation("ScanVersions")
  printJobs     PrintJob[]

  @@index([linkToken])
  @@index([parentScanId])
  @@index([isLatest])
  @@map("scans")
  @@schema("clinical_schema")
}

// ============================================================
// PRINT JOB MODEL (PDF Generation History)
// ============================================================
// Tracks every PDF generation for a scan
// Helps with audit and version history
// ============================================================
model PrintJob {
  id        Int      @id @default(autoincrement())
  scanId    String   @map("scan_id") @db.Uuid
  pdfPath   String   @map("pdf_path")
  createdAt DateTime @default(now()) @map("created_at")

  scan      Scan     @relation(fields: [scanId], references: [scanId], onDelete: Cascade)

  @@index([scanId])
  @@map("print_jobs")
  @@schema("clinical_schema")
}

// ============================================================
// AUDIT LOG MODEL (System Activity Tracking)
// ============================================================
// Append-only log for all clinical data access/modification
// ============================================================
model AuditLog {
  logId        String    @id @default(uuid()) @map("log_id") @db.Uuid
  linkToken    String    @map("link_token")
  action       String
  scanId       String?   @map("scan_id") @db.Uuid
  status       String
  errorMessage String?   @map("error_message")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  timestamp    DateTime? @default(now())

  @@map("audit_logs")
  @@schema("clinical_schema")
}

// ============================================================
// PATIENT PROFILE MODEL
// ============================================================
// Preferences and profile data for patients
// ============================================================
model PatientProfile {
  profileId         String   @id @default(uuid()) @map("profile_id") @db.Uuid
  linkToken         String   @unique @map("link_token")
  profilePicUrl     String?  @map("profile_pic_url")
  preferredLanguage String?  @default("en") @map("preferred_language")
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @default(now()) @map("updated_at")

  @@map("patient_profiles")
  @@schema("clinical_schema")
}

// ============================================================
// DOCTOR CLINICAL MODEL
// ============================================================
// doctorToken references identity_schema.doctor_link_tokens.doctor_token
// isApproved: must be approved by admin before accessing patients
// ============================================================
model Doctor {
  doctorId       String   @id @default(uuid()) @map("doctor_id") @db.Uuid
  doctorToken    String   @unique @map("doctor_token")
  specialization String?
  qualification  String?
  experience     Int?
  isApproved     Boolean  @default(false) @map("is_approved")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @default(now()) @map("updated_at")

  @@map("doctors")
  @@schema("clinical_schema")
}

// ============================================================
// MEDICINE MODEL (Reference Catalog)
// ============================================================
// Shared reference data — not linked to any patient
// Used by the recommender system (BE-3)
// ============================================================
model Medicine {
  id               Int      @id @default(autoincrement())
  name             String
  composition      String?
  uses             String?
  sideEffects      String?  @map("side_effects")
  imageUrl         String?  @map("image_url")
  manufacturer     String?
  excellentReview  Decimal? @map("excellent_review")
  averageReview    Decimal? @map("average_review")
  poorReview       Decimal? @map("poor_review")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("medicines")
  @@schema("clinical_schema")
}

// ============================================================
// CONSULTATION MODEL
// ============================================================
// Links doctors and patients for consultation sessions
// ============================================================
model Consultation {
  consultationId String   @id @default(uuid()) @map("consultation_id") @db.Uuid
  doctorToken    String   @map("doctor_token")
  linkToken      String   @map("link_token")
  status         String   @default("ACTIVE")
  notes          String?
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @default(now()) @map("updated_at")

  @@index([doctorToken])
  @@index([linkToken])
  @@map("consultations")
  @@schema("clinical_schema")
}

// ============================================================
// CONSENT LOG MODEL
// ============================================================
// Append-only log for patient consent (BE-2)
// Every accept/decline creates a new row — never updated/deleted
// ============================================================
model ConsentLog {
  consentId      String   @id @default(uuid()) @map("consent_id") @db.Uuid
  linkToken      String   @map("link_token")
  consentGiven   Boolean  @map("consent_given")
  consentVersion String   @map("consent_version")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([linkToken])
  @@map("consent_logs")
  @@schema("clinical_schema")
}

// Reward points system. Two tables by design:
//   - RewardAccount holds the current balance (one row per patient)
//   - RewardTransaction is the append-only ledger (every earn/redeem
//     is a row here, never edited) — this is what lets the balance
//     be reconstructed/audited if it's ever in doubt.
// Balance updates and transaction inserts always happen together in
// a single DB transaction — see rewardsController.js.
//
// Owner: BE-2
model RewardAccount {
  linkToken     String   @id @map("link_token")
  pointsBalance Int      @default(0) @map("points_balance")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("reward_accounts")
  @@schema("clinical_schema")
}

model RewardTransaction {
  transactionId String   @id @default(uuid()) @map("transaction_id") @db.Uuid
  linkToken     String   @map("link_token")
  points        Int
  type          String   // "EARNED" or "REDEEMED"
  reason        String
  // Prevents the same action (e.g. "profile_completed" for a given
  // patient) from awarding points twice if a request is retried/
  // double-clicked. Format: `${linkToken}_${reason}` or similar.
  actionKey     String   @unique @map("action_key")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([linkToken])
  @@map("reward_transactions")
  @@schema("clinical_schema")
}

// A patient's request to redeem points for something (a discount,
// a benefit, etc). Points are deducted immediately when the request
// is created (so they can't be spent twice while pending), and an
// admin approves or rejects it afterward. A rejection refunds the
// points. See rewardsController.js for the full flow.
//
// Owner: BE-2
model RedemptionRequest {
  redemptionId    String    @id @default(uuid()) @map("redemption_id") @db.Uuid
  linkToken       String    @map("link_token")
  pointsRequested Int       @map("points_requested")
  status          String    @default("PENDING")
  reason          String?
  requestedAt     DateTime  @default(now()) @map("requested_at")
  reviewedAt      DateTime? @map("reviewed_at")

  @@index([linkToken])
  @@map("redemption_requests")
  @@schema("clinical_schema")
}