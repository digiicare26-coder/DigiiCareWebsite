// ============================================================
// DATABASE: identity_schema
// PATH: prisma/identity/schema.prisma
// ============================================================
// This schema manages all identity/authentication data:
// - Patients (independent + linked family accounts)
// - Doctors (independent accounts)
// - OTP verifications (patient + doctor)
// - Link tokens (patient + doctor)
// - Revoked tokens (JWT blacklist)
// - Scans + PrintJobs (clinical data stored in identity schema)
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../../generated/identity-client"
}

datasource db {
  provider = "postgresql"
  url      = env("IDENTITY_DATABASE_URL")
  schemas  = ["identity_schema", "clinical_schema"]  // ✅ Both schemas
}

// ============================================================
// PATIENT MODEL (Identity)
// ============================================================
// - Independent account: uid = "1", "2", "3"...
// - Linked account: uid = "{parent_uid}_{n}" e.g. "1_1", "1_2"
// - passwordHash: NULL for linked accounts (they never login)
// ============================================================
model Patient {
  patientId      Int          @id @default(autoincrement()) @map("patient_id")
  fullName       String       @map("full_name")
  email          String?      @unique
  cnic           String?      @unique
  mobileNumber   String?      @unique @map("mobile_number")
  uid            String?      @unique
  passwordHash   String?      @map("password_hash")
  parentPatientId Int?        @map("parent_patient_id")
  relation       String?      // "child" or "spouse" for linked accounts
  linkToken      LinkToken?
  otpRequests    OtpVerification[]
  parent         Patient?     @relation("PatientFamily", fields: [parentPatientId], references: [patientId])
  children       Patient[]    @relation("PatientFamily")

  @@map("patients")
  @@schema("identity_schema")
}

// ============================================================
// PATIENT OTP MODEL
// ============================================================
// Lives in identity_schema — OTP is tied to mobile/CNIC/UID
// Never touches clinical_schema
// ============================================================
model OtpVerification {
  otpId       Int       @id @default(autoincrement()) @map("otp_id")
  patientId   Int       @map("patient_id")
  otpHash     String    @map("otp_hash")
  purpose     String    @default("LOGIN")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  consumed    Boolean   @default(false)
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  patient     Patient   @relation(fields: [patientId], references: [patientId])

  @@index([patientId, consumed])
  @@map("otp_verifications")
  @@schema("identity_schema")
}

// ============================================================
// PATIENT LINK TOKEN MODEL
// ============================================================
// One-to-one with Patient — used to access clinical data
// ============================================================
model LinkToken {
  linkToken String  @id @map("link_token")
  patientId Int     @unique @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [patientId])

  @@map("link_tokens")
  @@schema("identity_schema")
}

// ============================================================
// DOCTOR MODEL (Identity)
// ============================================================
// - Independent account with uid = "1", "2", "3"...
// - doctorToken is the clinical-side identifier
// ============================================================
model Doctor {
  doctorId      Int                    @id @default(autoincrement()) @map("doctor_id")
  fullName      String                 @map("full_name")
  email         String?                @unique
  licenseNumber String?                @unique @map("license_number")
  mobileNumber  String?                @unique @map("mobile_number")
  uid           String?                @unique
  passwordHash  String?                @map("password_hash")
  doctorToken   DoctorLinkToken?
  otpRequests   DoctorOtpVerification[]

  @@map("doctors")
  @@schema("identity_schema")
}

// ============================================================
// DOCTOR OTP MODEL
// ============================================================
// Similar to patient OTP but for doctors
// ============================================================
model DoctorOtpVerification {
  otpId       Int      @id @default(autoincrement()) @map("otp_id")
  doctorId    Int      @map("doctor_id")
  otpHash     String   @map("otp_hash")
  purpose     String   @default("LOGIN")
  attempts    Int      @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  consumed    Boolean  @default(false)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  doctor      Doctor   @relation(fields: [doctorId], references: [doctorId])

  @@index([doctorId, consumed])
  @@map("doctor_otp_verifications")
  @@schema("identity_schema")
}

// ============================================================
// DOCTOR LINK TOKEN MODEL
// ============================================================
// One-to-one with Doctor — used to access clinical data
// ============================================================
model DoctorLinkToken {
  doctorToken String @id @map("doctor_token")
  doctorId    Int    @unique @map("doctor_id")
  doctor      Doctor @relation(fields: [doctorId], references: [doctorId])

  @@map("doctor_link_tokens")
  @@schema("identity_schema")
}

// ============================================================
// 🆕 ADMIN MODEL (Identity)
// ============================================================
// - Exactly one admin exists at first (created via the one-time
//   bootstrap endpoint, only usable while zero admins exist).
// - That admin (and any admin after it) can create further admins
//   via the protected "create admin" endpoint — never public signup.
// - createdByAdminId is null only for the very first (bootstrap) admin.
// ============================================================
model Admin {
  adminId         Int      @id @default(autoincrement()) @map("admin_id")
  fullName        String   @map("full_name")
  email           String   @unique
  passwordHash    String   @map("password_hash")
  createdByAdminId Int?    @map("created_by_admin_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("admins")
  @@schema("identity_schema")
}

// ============================================================
// 🆕 NOTIFICATION MODEL (Identity)
// ============================================================
// Generic in-app notification for BOTH patients and doctors.
// recipientType tells us which table recipientId points at:
//   - "PATIENT" -> patients.patient_id
//   - "DOCTOR"  -> doctors.doctor_id
// Kept generic (instead of two separate tables) so every existing
// action (OTP verified, document verified/rejected, doctor approved,
// consultation booked, family member linked, redemption reviewed,
// report/prescription uploaded, etc.) can create one the same way.
// ============================================================
model Notification {
  notificationId Int      @id @default(autoincrement()) @map("notification_id")
  recipientType  String   @map("recipient_type") // "PATIENT" | "DOCTOR"
  recipientId    Int      @map("recipient_id")
  type           String   // e.g. "OTP_VERIFIED", "DOCTOR_APPROVED", "DOCUMENT_VERIFIED"...
  title          String
  message        String
  data           Json?
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([recipientType, recipientId, isRead])
  @@map("notifications")
  @@schema("identity_schema")
}

// ============================================================
// REVOKED TOKEN MODEL (JWT Blacklist)
// ============================================================
// Both patient and doctor JWTs go here for logout
// ============================================================
model RevokedToken {
  token     String   @id
  revokedAt DateTime @default(now()) @map("revoked_at")
  expiresAt DateTime @map("expires_at")

  @@map("revoked_tokens")
  @@schema("identity_schema")
}

// ============================================================
// CLINICAL SCHEMA MODELS (Stored in identity_schema for simplicity)
// ============================================================
// NOTE: These models are defined here because they reference
// identity_schema tables. In production, these should be in
// prisma/clinical/schema.prisma with multiSchema support.
// ============================================================

model Scan {
  scanId        String    @id @default(uuid()) @map("scan_id") @db.Uuid
  linkToken     String    @map("link_token")
  scanType      String    @map("scan_type")
  fileName      String    @map("file_name")
  filePath      String    @map("file_path")
  thumbnailPath String?   @map("thumbnail_path")
  fileSize      Int?      @map("file_size")
  mimeType      String?   @map("mime_type")
  ocrText       String?   @map("ocr_text")
  ocrConfidence Float?    @map("ocr_confidence")
  status        String    @default("UPLOADED")
  metadata      Json?
  uploadedAt    DateTime? @default(now()) @map("uploaded_at")
  processedAt   DateTime? @map("processed_at")

  // 🆕 BE-4: Report History/Versioning fields
  version       Int       @default(1) @map("version")
  parentScanId  String?   @map("parent_scan_id") @db.Uuid
  isLatest      Boolean   @default(true) @map("is_latest")

  // 🆕 BE-4: Print fields
  printedPdfPath String?   @map("printed_pdf_path")
  printedAt      DateTime? @map("printed_at")

  // Relations
  parentScan    Scan?     @relation("ScanVersions", fields: [parentScanId], references: [scanId])
  versions      Scan[]    @relation("ScanVersions")

  printJobs     PrintJob[]

  @@index([linkToken])
  @@index([parentScanId])
  @@index([isLatest])
  @@map("scans")
  @@schema("clinical_schema")  // ✅ Explicitly in clinical_schema
}

// 🆕 BE-4: PrintJob model
model PrintJob {
  id        Int      @id @default(autoincrement())
  scanId    String   @map("scan_id") @db.Uuid
  pdfPath   String   @map("pdf_path")
  createdAt DateTime @default(now()) @map("created_at")

  scan      Scan     @relation(fields: [scanId], references: [scanId], onDelete: Cascade)

  @@index([scanId])
  @@map("print_jobs")
  @@schema("clinical_schema")  // ✅ Explicitly in clinical_schema
}