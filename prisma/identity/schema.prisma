generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../../generated/identity-client"
}

datasource db {
  provider = "postgresql"
  url      = env("IDENTITY_DATABASE_URL")
  schemas  = ["identity_schema"]
}

model Patient {
  patientId    Int          @id @default(autoincrement()) @map("patient_id")
  fullName     String       @map("full_name")
  email        String?      @unique
  cnic         String?      @unique
  mobileNumber String?      @unique @map("mobile_number")
  // Sequential login ID: "1", "2", "3"... for an independent account.
  // "{parent_uid}_{n}" e.g. "1_1", "1_2" for a linked spouse/child
  // account. Generated in identityRepository.js.
  uid          String?      @unique
  // Hashed with bcrypt, never store the plain text password.
  // Always NULL for a linked spouse/child account — they never log
  // in on their own.
  passwordHash String?      @map("password_hash")
  // Sub-ID linking: NULL for an independent father/husband account.
  // Set to that patient's own patientId (self-FK) when this row is
  // a linked spouse/child account — see identityRepository.js ->
  // createSubAccount.
  parentPatientId Int?      @map("parent_patient_id")
  // Only set on a linked row: "child" or "spouse". NULL otherwise.
  relation     String?
  linkToken    LinkToken?
  otpRequests  OtpVerification[]
  parent       Patient?     @relation("PatientFamily", fields: [parentPatientId], references: [patientId])
  children     Patient[]    @relation("PatientFamily")

  @@map("patients")
  @@schema("identity_schema")
}

// Login OTP flow (BE-1). Lives in identity_schema on purpose —
// an OTP is only ever tied to a mobile number / CNIC / UID, which
// is identifying data. It never touches clinical_schema.
model OtpVerification {
  otpId       Int       @id @default(autoincrement()) @map("otp_id")
  patientId   Int       @map("patient_id")
  otpHash     String    @map("otp_hash")
  purpose     String    @default("LOGIN")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  consumed    Boolean   @default(false)
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  patient     Patient   @relation(fields: [patientId], references: [patientId])

  @@index([patientId, consumed])
  @@map("otp_verifications")
  @@schema("identity_schema")
}

model LinkToken {
  linkToken String  @id @map("link_token")
  patientId Int     @unique @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [patientId])

  @@map("link_tokens")
  @@schema("identity_schema")
}

// =============================================================
// Doctor identity + auth — mirrors Patient's signup/OTP/login
// shape exactly, just for doctors. Lives in its own tables so
// none of the Patient/OtpVerification/LinkToken models above are
// touched. doctorToken (below) is what src/routes/doctorRoute.js
// already expects as the clinical-side identifier, so a doctor
// signing up here can immediately use the existing
// POST /api/doctor endpoint with the doctorToken this issues.
// =============================================================
model Doctor {
  doctorId      Int                    @id @default(autoincrement()) @map("doctor_id")
  fullName      String                 @map("full_name")
  email         String?                @unique
  licenseNumber String?                @unique @map("license_number")
  mobileNumber  String?                @unique @map("mobile_number")
  // Sequential login ID assigned at signup time (1, 2, 3, ...),
  // from identity_schema.doctor_uid_seq — a separate sequence from
  // patients.uid, since doctors are a different account type.
  uid           String?                @unique
  passwordHash  String?                @map("password_hash")
  doctorToken   DoctorLinkToken?
  otpRequests   DoctorOtpVerification[]

  @@map("doctors")
  @@schema("identity_schema")
}

model DoctorOtpVerification {
  otpId       Int      @id @default(autoincrement()) @map("otp_id")
  doctorId    Int      @map("doctor_id")
  otpHash     String   @map("otp_hash")
  purpose     String   @default("LOGIN")
  attempts    Int      @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  consumed    Boolean  @default(false)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  doctor      Doctor   @relation(fields: [doctorId], references: [doctorId])

  @@index([doctorId, consumed])
  @@map("doctor_otp_verifications")
  @@schema("identity_schema")
}

model DoctorLinkToken {
  doctorToken String @id @map("doctor_token")
  doctorId    Int    @unique @map("doctor_id")
  doctor      Doctor @relation(fields: [doctorId], references: [doctorId])

  @@map("doctor_link_tokens")
  @@schema("identity_schema")
}

// Shared JWT blacklist for logout — both patient and doctor tokens
// go here. JWTs are stateless, so "logout" only becomes real once
// the token is checked against this table on every request (see
// src/middleware/auth.js and src/middleware/doctorAuth.js).
model RevokedToken {
  token     String   @id
  revokedAt DateTime @default(now()) @map("revoked_at")
  // Copied from the JWT's own expiry — lets a cleanup job purge
  // rows once the token would have expired naturally anyway.
  expiresAt DateTime @map("expires_at")

  @@map("revoked_tokens")
  @@schema("identity_schema")
}
